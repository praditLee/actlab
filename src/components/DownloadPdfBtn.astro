---
// src/components/DownloadPdfBtn.astro
interface Props {
  title?: string;
  download?: string | null | boolean | undefined;
}

const { title, download } = Astro.props;

// 1. แปลงค่าและตัดช่องว่าง
const rawString = typeof download === "string" ? download.trim() : "";

// 2. ตรวจสอบอย่างรัดกุม (ต้องเป็น String + มีความยาว > 0 + ต้องไม่ใช่ข้อความลวง)
const hasPdfFile =
  typeof download === "string" &&
  rawString.length > 0 &&
  rawString !== "undefined" &&
  rawString !== "null" &&
  rawString !== "false";

// 💡 [DEBUG LOG] สามารถดูค่าจริงที่ส่งมาได้ใน Terminal ของ VS Code ตอนเปิดหน้านี้
console.log(
  `[PdfBtn Debug] Title: "${title}" | Download value:`,
  download,
  `| HasFile:`,
  hasPdfFile,
);
---

{
  hasPdfFile ? (
    /* กรณีที่ 1: มีไฟล์ PDF จริงๆ -> ปุ่มดาวน์โหลด */
    <a
      href={download}
      download
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-full hover:bg-gray-700 transition-colors shadow-lg cursor-pointer no-underline"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
      <span class="font-medium text-sm">Download PDF</span>
    </a>
  ) : (
    /* กรณีที่ 2: ไม่มีไฟล์ PDF -> ปุ่ม Print / Save PDF */
    <button
      type="button"
      onclick="window.print()"
      class="flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-full hover:bg-gray-700 transition-colors shadow-lg cursor-pointer"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 9V2h12v7" />
        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
        <path d="M6 14h12v8H6z" />
      </svg>
      <span class="font-medium text-sm">Print / Save PDF</span>
    </button>
  )
}

<style>
  a {
    color: white;
  }
</style>
