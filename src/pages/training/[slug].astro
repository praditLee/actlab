---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

// 1. getStaticPaths: This tells Astro which URLs to generate.
export async function getStaticPaths() {
  const allLessons = await getCollection("training");

  // Filter for only this course
  const courseLessons = allLessons
    .filter((lesson) => lesson.data.courseId === "facilitator")
    .sort((a, b) => a.data.order - b.data.order);

  // Return an array of objects. Each object represents one page.
  return courseLessons.map((lesson) => ({
    params: {
      // Create a URL friendly slug (e.g., '1', '2', or '01-intro')
      // Using 'order' makes URLs simple: /training/facilitator/1
      slug: lesson.data.order.toString(),
    },
    props: {
      lesson, // The current lesson's data
      courseLessons, // The full list (for the sidebar)
    },
  }));
}

// 2. Extract the data for the *current* page being rendered.
const { lesson, courseLessons } = Astro.props;
const { Content } = await render(lesson);

// Group lessons by topic for a cleaner sidebar
const groupedLessons = courseLessons.reduce(
  (acc, curr) => {
    const topic = curr.data.topic;
    if (!acc[topic]) {
      acc[topic] = [];
    }
    acc[topic].push(curr);
    return acc;
  },
  {} as Record<string, any[]>,
);
---

<MainLayout title={`${lesson.data.title} | ${lesson.data.courseName}`}>
  <div class="flex flex-col md:flex-row max-w-7xl mx-auto min-h-screen">
    {/* --- Sidebar (Navigation) --- */}
    <aside
      class="w-full md:w-1/3 lg:w-1/4 bg-gray-50 border-r border-gray-200 p-4 sticky top-0 md:h-screen overflow-y-auto"
    >
      <h2 class="text-xl font-bold mb-6 text-gray-900">
        {lesson.data.courseName}
      </h2>

      <div class="space-y-6">
        {
          Object.entries(groupedLessons).map(([topic, lessons]) => (
            <div>
              {/* Topic Header */}
              <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">
                {topic}
              </h3>

              {/* Lessons under this topic */}
              <ul class="space-y-1">
                {lessons.map((l) => {
                  const isActive = l.id === lesson.id;
                  return (
                    <li>
                      <a
                        href={`/training/facilitator/${l.data.order}`}
                        class={`block p-3 rounded-lg border transition-colors ${
                          isActive
                            ? "bg-blue-50 border-blue-200 text-blue-700 font-semibold"
                            : "bg-white border-transparent text-gray-700 hover:border-gray-300 hover:bg-gray-100"
                        }`}
                      >
                        <div class="flex items-center justify-between">
                          <span>{l.data.title}</span>
                          {isActive && (
                            <svg
                              class="w-4 h-4 text-blue-600"
                              fill="currentColor"
                              viewBox="0 0 20 20"
                            >
                              <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"
                              />
                            </svg>
                          )}
                        </div>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </aside>

    {/* --- Main Content Area --- */}
    <main class="w-full md:w-2/3 lg:w-3/4 p-4 md:p-8">
      {/* Video Player */}
      {
        lesson.data.youtubeId && (
          <div class="aspect-w-16 aspect-h-9 bg-black rounded-xl overflow-hidden mb-8 shadow-lg">
            <iframe
              src={`https://www.youtube.com/embed/${lesson.data.youtubeId}?rel=0`}
              title={lesson.data.title}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="w-full h-full"
            />
          </div>
        )
      }

      {/* Lesson Text (Rendered Markdown) */}
      <article class="prose max-w-none prose-blue">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">
          {lesson.data.title}
        </h1>
        <Content />
      </article>

      {/* Basic Next/Prev Navigation (Optional, but good for LMS) */}
      <div class="mt-12 pt-6 border-t border-gray-200 flex justify-between">
        {
          (() => {
            const currentIndex = courseLessons.findIndex(
              (l) => l.id === lesson.id,
            );
            const prev = courseLessons[currentIndex - 1];
            const next = courseLessons[currentIndex + 1];

            return (
              <>
                <div>
                  {prev && (
                    <a
                      href={`/training/facilitator/${prev.data.order}`}
                      class="text-blue-600 hover:underline flex items-center gap-1"
                    >
                      &larr; บทก่อนหน้า
                    </a>
                  )}
                </div>
                <div>
                  {next && (
                    <a
                      href={`/training/facilitator/${next.data.order}`}
                      class="text-blue-600 hover:underline flex items-center gap-1"
                    >
                      บทถัดไป &rarr;
                    </a>
                  )}
                </div>
              </>
            );
          })()
        }
      </div>
    </main>
  </div>
</MainLayout>
