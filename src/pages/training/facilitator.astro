---
// src/pages/training/facilitator.astro
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

// 1. ดึงเนื้อหาทั้งหมดจากโฟลเดอร์ training
const allLessons = await getCollection("training");

// 2. กรองเอาเฉพาะคอร์ส "facilitator" และเรียงลำดับตาม order (1, 2, 3...)
const facilitatorLessons = allLessons
  .filter((lesson) => lesson.data.courseId === "facilitator")
  .sort((a, b) => a.data.order - b.data.order);

// 3. กำหนดให้บทเรียนแรกเป็นค่าเริ่มต้น (ตอนเปิดหน้าเว็บมาครั้งแรก)
const currentLesson = facilitatorLessons[0];
---

<MainLayout title="ห้องเรียน Facilitator">
  <div class="flex flex-col md:flex-row max-w-7xl mx-auto min-h-screen">
    <aside
      class="w-full md:w-1/3 lg:w-1/4 bg-gray-50 border-r border-gray-200 p-4"
    >
      <h2 class="text-xl font-bold mb-4">{currentLesson.data.courseName}</h2>
      <ul class="space-y-2">
        {
          facilitatorLessons.map((lesson) => (
            <div class="text-xs text-gray-500">{lesson.data.topic}</div>
            <li>
              <a
                href={`#${lesson.data.order}`}
                class="block p-3 bg-white rounded-lg shadow-sm hover:border-blue-500 border border-transparent"
              >
                
                <div class="font-medium text-gray-900">{lesson.data.title}</div>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    <main class="w-full md:w-2/3 lg:w-3/4 p-4 md:p-8">
      <div
        class="aspect-w-16 aspect-h-9 bg-black rounded-xl overflow-hidden mb-8"
      >
        <iframe
          src={`https://www.youtube.com/embed/${currentLesson.data.youtubeId}`}
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="w-full h-full min-h-[480px]"></iframe>
      </div>

      <article class="prose max-w-none">
        <h1>{currentLesson.data.title}</h1>
        <p>เนื้อหาบทเรียนจะแสดงตรงนี้...</p>
      </article>
    </main>
  </div>
</MainLayout>
